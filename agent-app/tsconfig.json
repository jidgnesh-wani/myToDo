{
  "extends": "@agent-native/core/tsconfig.base.json",
  "compilerOptions": {
    // Keep at "5.0": the editor LSP (bundled TS 5.9) rejects "6.0", and the project's TS 7 accepts both.
    "ignoreDeprecations": "5.0",
    "rootDirs": [".", "./.react-router/types"],
    "paths": {
      "*": ["./*"],
      "@/*": ["./app/*"],
      "@shared/*": ["./shared/*"]
    }
  },
  "include": [
    "app/**/*",
    "server/**/*",
    "shared/**/*",
    "scripts/**/*",
    "vite.config.ts",
    "react-router.config.ts",
    ".react-router/types/**/*",
    ".generated/**/*"
  ]
}
